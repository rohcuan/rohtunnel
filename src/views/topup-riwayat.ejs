<%- include('partials/head') %>
  <div class="header-section">
    <div>
      <div class="page-title">Riwayat Saldo Panel</div>
      <div class="page-subtitle">Riwayat topup QRIS dan pemakaian saldo panel kamu.</div>
    </div>
  </div>

  <div class="card">
    <div style="font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;color:#888;margin-bottom:8px;">Saldo Panel Saat Ini</div>
    <div style="font-size:1.4rem;font-weight:700;color:#059669;"><%= formatRupiah(balance) %></div>
  </div>

  <div class="card">
    <% if (history.length) { %>
    <div class="topup-table-wrap" style="overflow-x:auto;">
      <table class="topup-table">
        <thead>
          <tr><th>Waktu</th><th>Tipe</th><th>Jumlah</th><th>Keterangan</th><th>Aksi</th></tr>
        </thead>
        <tbody>
          <% history.forEach(t => { %>
          <tr>
            <td><%= new Date(t.ts).toLocaleString('id-ID') %></td>
            <td><%= t.kind === 'topup' ? (t.status === 'paid' ? 'Topup QRIS (Lunas)' : t.status === 'expired' ? 'Topup QRIS (Kedaluwarsa)' : 'Topup QRIS') : t.label %></td>
            <td style="font-weight:600;color:<%= t.amount >= 0 ? '#059669' : '#dc2626' %>;">
              <%= t.amount >= 0 ? '+' : '-' %><%= formatRupiah(Math.abs(t.amount)) %>
            </td>
            <td><%= t.desc %></td>
            <td>
              <% if (t.kind === 'topup' && t.show_qris_link) { %>
              <button type="button" class="btn-mini" onclick="openQr(<%= t.id %>, <%= t.amount %>)">Lihat kode QRIS</button>
              <% } else if (t.kind === 'topup' && t.show_check) { %>
              <button type="button" class="btn-mini check-btn" data-id="<%= t.id %>" onclick="manualCheck(this)">Cek Pembayaran</button>
              <% } else { %>&mdash;<% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="topup-cards">
      <% history.forEach(t => { %>
      <div class="topup-card">
        <div class="tc-head">
          <span class="tc-time"><%= new Date(t.ts).toLocaleString('id-ID') %></span>
          <span><%= t.kind === 'topup' ? 'Topup QRIS' : t.label %></span>
        </div>
        <div class="tc-row"><span class="k">Jumlah</span><span class="v" style="color:<%= t.amount >= 0 ? '#059669' : '#dc2626' %>;"><%= t.amount >= 0 ? '+' : '-' %><%= formatRupiah(Math.abs(t.amount)) %></span></div>
        <div class="tc-row"><span class="k">Keterangan</span><span class="v"><%= t.desc %></span></div>
        <div class="tc-actions">
          <% if (t.kind === 'topup' && t.show_qris_link) { %>
          <button type="button" class="btn-mini" onclick="openQr(<%= t.id %>, <%= t.amount %>)">Lihat kode QRIS</button>
          <% } else if (t.kind === 'topup' && t.show_check) { %>
          <button type="button" class="btn-mini check-btn" data-id="<%= t.id %>" onclick="manualCheck(this)">Cek Pembayaran</button>
          <% } else { %><span>&mdash;</span><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="alert">Belum ada transaksi.</div>
    <% } %>
  </div>

  <div class="qr-overlay" id="qr-overlay" onclick="if(event.target===this)closeQr(false)">
    <div class="qr-window">
      <button class="qr-close" onclick="closeQr(false)">&times;</button>

      <div id="qr-view-loading">
        <h3>Menyiapkan QRIS</h3>
        <p>Mengambil kode QR dari payment gateway...</p>
        <div class="spinner"></div>
        <div class="load-error" id="qr-load-error"></div>
        <div style="margin-top:14px;display:none;" id="qr-load-retry-wrap">
          <button class="btn btn-success" id="qr-load-retry" style="width:100%;" onclick="fetchQr()">Coba lagi</button>
        </div>
      </div>

      <div id="qr-view-pay">
        <h3>Scan QRIS</h3>
        <p>Selesaikan pembayaran dengan memindai kode QR ini.</p>
        <img class="qr-img" id="qr-img" alt="QRIS" src="">
        <div class="qr-total">Total: <strong id="qr-total">&mdash;</strong></div>
        <div style="margin-top:10px;font-size:.85rem;color:#374151;">
          Sisa waktu: <strong id="qr-timer" style="font-family:ui-monospace,monospace;">&mdash;</strong>
        </div>
        <div id="qr-expired-note" style="display:none;margin-top:8px;padding:10px 12px;border-radius:8px;background:#fef2f2;color:#991b1b;font-size:.8rem;line-height:1.5;">
          QRIS sudah kedaluwarsa dan tidak dapat dipindai lagi. Jika sudah membayar, tekan <strong>Cek Pembayaran</strong>.
        </div>
        <div style="margin-top:14px;">
          <button class="btn btn-success" id="check-btn" onclick="checkStatus()" style="width:100%;">Cek Pembayaran</button>
        </div>
        <div class="qr-hint">QRIS berlaku 5 menit. Atau tekan <strong>Cek Pembayaran</strong> agar tidak perlu menunggu terlalu lama.</div>
      </div>

      <div id="qr-view-success" style="display:none;">
        <h3 class="success-title">Topup Berhasil!</h3>
        <p>Pembayaran terkonfirmasi dan saldo sudah ditambahkan ke akunmu.</p>
        <div class="success-box">
          <div class="success-row">
            <span class="k">Saldo ditambahkan</span>
            <span class="v added" id="success-added">&mdash;</span>
          </div>
          <div class="success-row total">
            <span class="k">Saldo panel sekarang</span>
            <span class="v" id="success-balance">&mdash;</span>
          </div>
        </div>
        <div style="margin-top:16px;">
          <button class="btn btn-success" onclick="closeQr(true)" style="width:100%;">Selesai</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="qrisClosedModal" onclick="if(event.target===this)closeQrisClosedModal()">
    <div class="modal">
      <h3>Tidak sengaja menutup QRIS?</h3>
      <div class="modal-body">
        <p style="margin:0;">Topup kamu yang masih aktif bisa dilihat kembali. Di halaman ini, pilih <strong>Lihat kode QRIS</strong> pada transaksi terkait untuk membukanya lagi.</p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-primary" onclick="closeQrisClosedModal()">Oke, Saya Mengerti</button>
      </div>
    </div>
  </div>

  <script>
    var COOLDOWN = <%= cooldown %>;
    var qrExpires = 0;
    var qrTimerInt = null;
    var currentTopupId = null;
    var currentQrParams = null;

    function fmtIdr(n) { return Number(n || 0).toLocaleString('id-ID'); }
    function fmtLeft(s) {
      var m = Math.floor(s / 60), r = s % 60;
      return m > 0 ? m + 'm ' + (r < 10 ? '0' : '') + r + 's' : r + 's';
    }

    function tickCheckBtn(b) {
      var dl = parseInt(b.dataset.deadline || '0', 10);
      var left = Math.max(0, Math.round((dl - Date.now()) / 1000));
      if (left <= 0) { b.disabled = false; b.textContent = 'Cek Pembayaran'; return; }
      b.textContent = 'Tunggu ' + fmtLeft(left);
      setTimeout(function() { tickCheckBtn(b); }, 1000);
    }

    function manualCheck(btn) {
      if (btn.disabled) return;
      btn.disabled = true;
      btn.textContent = 'Mengecek...';
      var fd = new FormData();
      fd.append('topup_id', btn.dataset.id);
      fetch('/topup/check', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (res.ok && res.status === 'paid') { location.reload(); return; }
          var cd = parseInt(res.cooldown || '0', 10);
          if (cd > 0) {
            btn.dataset.deadline = Date.now() + cd * 1000;
            tickCheckBtn(btn);
          } else {
            btn.disabled = false;
            btn.textContent = 'Cek Pembayaran';
          }
          alert(res.message || (res.ok ? 'Belum ada pembayaran terdeteksi.' : 'Gagal mengecek status.'));
        })
        .catch(function() {
          btn.disabled = false;
          btn.textContent = 'Cek Pembayaran';
        });
    }

    function openQr(topupId, amount) {
      currentTopupId = topupId;
      currentQrParams = { id: topupId, amount: amount };
      showQrLoading();
      fetchQr();
    }

    function fetchQr() {
      var p = currentQrParams;
      if (!p) return;
      document.getElementById('qr-load-error').classList.remove('show');
      document.getElementById('qr-load-retry-wrap').style.display = 'none';
      fetch('/topup/qr/' + p.id, { credentials: 'same-origin', cache: 'no-store' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (currentQrParams !== p) return;
          if (!res.ok) {
            showQrError(res.message || 'Payment gateway sedang offline. QRIS tidak dapat ditampilkan.');
            return;
          }
          showQr(res.qr_img, res.expires_ts);
        })
        .catch(function() {
          if (currentQrParams !== p) return;
          showQrError('Payment gateway sedang offline. QRIS tidak dapat ditampilkan.');
        });
    }

    function showQrLoading() {
      qrExpires = 0;
      setQrViewState('loading');
      document.getElementById('qr-overlay').classList.add('show');
    }

    function showQrError(msg) {
      setQrViewState('loading');
      var errEl = document.getElementById('qr-load-error');
      errEl.textContent = msg;
      errEl.classList.add('show');
      document.getElementById('qr-load-retry-wrap').style.display = '';
    }

    function showQr(src, expires) {
      qrExpires = parseInt(expires, 10) || 0;
      var img = document.getElementById('qr-img');
      if (img) { img.src = src || ''; img.style.display = ''; }
      var note = document.getElementById('qr-expired-note');
      if (note) note.style.display = 'none';
      setQrViewState('pay');
      resetCheckBtn();
      document.getElementById('qr-overlay').classList.add('show');
      tickQrTimer();
      if (qrTimerInt) clearInterval(qrTimerInt);
      qrTimerInt = setInterval(tickQrTimer, 1000);
    }

    function setQrViewState(state) {
      document.getElementById('qr-view-loading').style.display = state === 'loading' ? '' : 'none';
      document.getElementById('qr-view-pay').style.display = state === 'pay' ? '' : 'none';
      document.getElementById('qr-view-success').style.display = state === 'success' ? '' : 'none';
    }

    function tickQrTimer() {
      var el = document.getElementById('qr-timer');
      if (!el) return;
      if (!qrExpires) { el.textContent = '\u2014'; return; }
      var left = qrExpires - Math.floor(Date.now() / 1000);
      if (left <= 0) {
        el.textContent = 'Expired';
        var img = document.getElementById('qr-img');
        if (img) img.style.display = 'none';
        var note = document.getElementById('qr-expired-note');
        if (note) note.style.display = '';
        if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
        return;
      }
      var m = Math.floor(left / 60), s = left % 60;
      el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }

    function resetCheckBtn() {
      var btn = document.getElementById('check-btn');
      if (!btn) return;
      btn.disabled = false;
      btn.textContent = 'Cek Pembayaran';
      if (window.checkCdInt) { clearInterval(window.checkCdInt); window.checkCdInt = null; }
    }

    function armCheckCooldown(seconds) {
      var btn = document.getElementById('check-btn');
      if (!btn) return;
      if (window.checkCdInt) { clearInterval(window.checkCdInt); window.checkCdInt = null; }
      var deadline = Date.now() + seconds * 1000;
      btn.disabled = true;
      btn.textContent = 'Tunggu ' + fmtLeft(seconds);
      window.checkCdInt = setInterval(function() {
        var left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
        if (left <= 0) {
          clearInterval(window.checkCdInt);
          window.checkCdInt = null;
          btn.disabled = false;
          btn.textContent = 'Cek Pembayaran';
          return;
        }
        btn.textContent = 'Tunggu ' + fmtLeft(left);
      }, 1000);
    }

    function checkStatus() {
      var btn = document.getElementById('check-btn');
      var tid = currentTopupId;
      if (!tid) return;
      if (btn && btn.disabled) return;
      if (btn) { btn.disabled = true; btn.textContent = 'Mengecek...'; }
      var fd = new FormData();
      fd.append('topup_id', tid);
      fetch('/topup/check', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (currentTopupId !== tid) return;
          var cd = parseInt(res.cooldown || '0', 10);
          if (!res.ok) {
            if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
            alert(res.message || 'Gagal mengecek status.');
            return;
          }
          if (res.status === 'paid') {
            if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
            document.getElementById('success-added').textContent = '+' + fmtIdr(res.credited) + ' IDR';
            document.getElementById('success-balance').textContent = fmtIdr(res.new_balance) + ' IDR';
            setQrViewState('success');
            return;
          }
          if (res.status === 'expired') {
            if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
            var timerEl = document.getElementById('qr-timer');
            if (timerEl) timerEl.textContent = 'Expired';
            var img = document.getElementById('qr-img');
            if (img) img.style.display = 'none';
            var note = document.getElementById('qr-expired-note');
            if (note) note.style.display = '';
            if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
            alert(res.message || 'QRIS kedaluwarsa dan tidak ada pembayaran masuk.');
            return;
          }
          if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
          alert(res.message || 'Belum ada pembayaran terdeteksi.');
        })
        .catch(function() { if (btn) resetCheckBtn(); });
    }

    function closeQr(reload) {
      var ov = document.getElementById('qr-overlay');
      var wasPaid = document.getElementById('qr-view-success').style.display !== 'none';
      ov.classList.remove('show');
      if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
      resetCheckBtn();
      document.getElementById('qr-load-error').classList.remove('show');
      document.getElementById('qr-load-retry-wrap').style.display = 'none';
      currentQrParams = null;
      currentTopupId = null;
      if (reload && wasPaid) { location.reload(); return; }
      if (!wasPaid) {
        document.getElementById('qrisClosedModal').classList.add('show');
      }
    }
    function closeQrisClosedModal() {
      document.getElementById('qrisClosedModal').classList.remove('show');
    }
  </script>
<%- include('partials/footer') %>