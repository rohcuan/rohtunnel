<%- include('../partials/head') %>
  <div class="page-title">
    <h1>Manager Akun VPN</h1>
    <p>Semua akun dari semua server (SSH &amp; V2Ray) dengan pencarian.</p>
  </div>

  <% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <form method="get" action="/admin/akun" class="filter-form">
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari username akun / pemilik..." class="form-control search-field">
      <select name="protocol">
        <option value="">Semua protocol</option>
        <% protocols.forEach(p => { %>
          <option value="<%= p %>" <%= filters.protocol === p ? 'selected' : '' %>><%= p.toUpperCase() %></option>
        <% }) %>
      </select>
      <select name="server_id">
        <option value="">Semua server</option>
        <% servers.forEach(s => { %>
          <option value="<%= s.id %>" <%= filters.serverId == s.id ? 'selected' : '' %>><%= s.code %> · <%= s.label %></option>
        <% }) %>
      </select>
      <select name="status">
        <option value="">Semua status</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
      <div class="filter-actions">
        <button type="submit" class="btn btn-primary btn-sm">Cari</button>
        <a href="/admin/akun" class="btn btn-outline btn-sm">Reset</a>
      </div>
    </form>
  </div>

  <h3 class="section-title">Hasil (<%= accounts.length %>)</h3>
  <% if (accounts.length === 0) { %>
    <div class="card">
      <p class="muted">Tidak ada akun ditemukan.</p>
    </div>
  <% } else { %>
    <% const backUrl = '/admin/akun?' + (filters.q ? 'q=' + encodeURIComponent(filters.q) + '&' : '') + (filters.protocol ? 'protocol=' + filters.protocol + '&' : '') + (filters.serverId ? 'server_id=' + filters.serverId + '&' : '') + (filters.status ? 'status=' + filters.status + '&' : ''); %>
    <% accounts.forEach(a => { %>
      <%- include('partials/akun-card', { a, back: backUrl }) %>
    <% }) %>
  <% } %>
<%- include('../partials/footer') %>