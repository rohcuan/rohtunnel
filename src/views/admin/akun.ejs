<%- include('../partials/head') %>
  <div class="page-title">
    <h1>Manager Akun VPN</h1>
    <p>Semua akun dari semua server (SSH &amp; V2Ray) dengan pencarian.</p>
  </div>

  <% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <form method="get" action="/admin/akun" class="filter-form">
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Cari username akun / pemilik...">
      <select name="protocol">
        <option value="">Semua protocol</option>
        <% protocols.forEach(p => { %>
          <option value="<%= p %>" <%= filters.protocol === p ? 'selected' : '' %>><%= p.toUpperCase() %></option>
        <% }) %>
      </select>
      <select name="server_id">
        <option value="">Semua server</option>
        <% servers.forEach(s => { %>
          <option value="<%= s.id %>" <%= filters.serverId == s.id ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
      <select name="status">
        <option value="">Semua status</option>
        <% statuses.forEach(st => { %>
          <option value="<%= st %>" <%= filters.status === st ? 'selected' : '' %>><%= statusLabel(st) %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Cari</button>
      <a href="/admin/akun" class="btn btn-outline btn-sm">Reset</a>
    </form>
  </div>

  <div class="card">
    <h3>Hasil (<%= accounts.length %>)</h3>
    <% if (accounts.length === 0) { %>
      <p class="muted">Tidak ada akun ditemukan.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Username</th><th>Proto</th><th>Server</th><th>Pemilik</th><th>Status</th>
            <th>Kuota</th><th>IP</th><th>Expired</th><th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% accounts.forEach(a => { %>
            <tr>
              <td class="cell-mono"><%= a.username %></td>
              <td><span class="badge badge-country"><%= a.protocol.toUpperCase() %></span></td>
              <td><%= a.server_name %> <span class="badge badge-country"><%= a.server_country.toUpperCase() %></span></td>
              <td><a href="/admin/users/<%= a.user_id %>"><%= a.owner_name %></a></td>
              <td><span class="badge badge-<%= a.status %>"><%= statusLabel(a.status) %></span></td>
              <td><%= a.kuota_gb %> GB</td>
              <td><%= a.limit_ip %></td>
              <td><%= new Date(a.expired_at).toLocaleDateString('id-ID') %></td>
              <td><%- include('partials/akun-actions', { a, back: '/admin/akun?' + (filters.q ? 'q=' + encodeURIComponent(filters.q) + '&' : '') + (filters.protocol ? 'protocol=' + filters.protocol + '&' : '') + (filters.serverId ? 'server_id=' + filters.serverId + '&' : '') + (filters.status ? 'status=' + filters.status + '&' : '') }) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<%- include('../partials/footer') %>