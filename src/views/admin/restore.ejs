<%- include('../partials/head') %>
  <div class="page-title">
    <h1>Restore Backup</h1>
    <p><a href="/admin/setup" class="muted-link">← Setup</a></p>
  </div>

  <% if (msg) { %><div class="alert alert-success"><%= msg %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <h3>Upload File Backup (.db)</h3>
    <form method="post" action="/admin/restore" enctype="multipart/form-data">
      <input type="file" name="backup_file" accept=".db" required>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"
                onclick="return confirm('Database AKAN DITIMPA saat restart berikutnya. Lanjutkan?');">Upload &amp; Restore</button>
      </div>
    </form>
    <div class="alert">
      <strong>Penting:</strong> DB lama diarsipkan otomatis sebagai <code>pre-restore-*.db</code>.
      Restore diterapkan saat container restart berikutnya (di Portainer: redeploy stack / restart container).
    </div>
  </div>

  <div class="card">
    <h3>Backup yang Tersedia di Server</h3>
    <% if (backups.length === 0) { %>
      <p class="muted">Tidak ada file backup di <code>data/backup/</code>.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Nama</th><th>Ukuran</th></tr></thead>
        <tbody>
          <% backups.slice(0, 15).forEach(b => { %>
            <tr><td class="cell-mono"><%= b.name %></td><td><%= (b.size / 1024).toFixed(1) %> KB</td></tr>
          <% }) %>
        </tbody>
      </table>
      <p class="muted">Unduh dari Telegram bila perlu; upload di form atas untuk restore.</p>
    <% } %>
  </div>
<%- include('../partials/footer') %>