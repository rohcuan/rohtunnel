<%- include('../partials/head') %>
  <div class="page-title">
    <h1>Manage Server</h1>
    <p>Kelola server VPN (endpoint Potato API + API key) tanpa perlu membuka Pengaturan.</p>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <div class="list-head">
      <h3>List Server</h3>
      <a href="/admin/servers/new" class="btn btn-primary">Tambah Server</a>
    </div>
    <% if (servers.length === 0) { %>
      <p class="muted">Belum ada server. Tambahkan server pertama lewat tombol di atas.</p>
    <% } else { %>
      <% servers.forEach(s => { %>
        <div class="card server-list-card">
          <button type="button" class="server-card-toggle" onclick="toggleServerCard(this)">
            <div class="server-card-title">
              <strong class="server-card-label"><%= s.label %></strong>
              <span class="badge badge-country"><%= s.code %></span>
            </div>
            <svg class="chevron server-card-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="server-card-actions">
            <a href="/admin/servers/<%= s.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
            <a href="/admin/servers/<%= s.id %>/packages" class="btn btn-outline btn-sm">Pricing</a>
            <form method="post" action="/admin/servers/<%= s.id %>/delete" class="inline-form"
                  onsubmit="return confirm('Hapus server <%= s.code %> — <%= s.label %> beserta semua package-nya?');">
              <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
            </form>
          </div>
          <div class="server-card-body">
            <div class="server-card-info">
              <span class="server-card-info-label">Endpoint</span>
              <span class="server-card-info-value"><%= s.endpoint %></span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">API Key</span>
              <span class="server-card-info-value"><%= s.api_key || '-' %></span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">Limit VPN</span>
              <span class="server-card-info-value"><%= s.limit_vpn === 0 ? 'Tak terbatas' : s.limit_vpn %></span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">Country</span>
              <span class="server-card-info-value"><%= ({id:'Indonesia', sg:'Singapore', us:'USA'})[s.country] || s.country %></span>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
  <script>
    function toggleServerCard(btn) {
      btn.closest('.server-list-card').classList.toggle('server-list-card-open');
    }
  </script>
<%- include('../partials/footer') %>