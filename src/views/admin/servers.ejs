<%- include('../partials/head') %>
  <div class="page-title">
    <h1>Manage Server</h1>
    <p>Tambahkan server VPN (endpoint Potato API + API key) dan atur pricing package-nya.</p>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <h3><%= editing ? 'Edit Server: ' + editing.code + ' · ' + editing.label : 'Tambah Server' %></h3>
    <form method="post" action="<%= editing ? '/admin/servers/' + editing.id + '/edit' : '/admin/servers/add' %>">
      <div class="row">
        <label>Kode Server
          <input type="text" name="code" placeholder="Contoh: SRV-A" required maxlength="20" pattern="[A-Za-z0-9-]+" title="Huruf besar, angka, atau -" style="text-transform:uppercase" value="<%= values.code %>">
        </label>
        <label>Label
          <input type="text" name="label" placeholder="Contoh: LinkGo Metro Teknologi" required maxlength="100" value="<%= values.label %>">
        </label>
        <label>Endpoint API
          <input type="url" name="endpoint" placeholder="https://rohserver1.dpdns.org" required value="<%= values.endpoint %>">
        </label>
        <p class="muted form-hint">Tanpa /vps — path /vps otomatis ditambahkan aplikasi.</p>
        <label>API Key
          <input type="password" name="api_key" placeholder="Bearer token" required value="<%= values.api_key %>">
        </label>
      </div>
      <div class="row">
        <label>Country
          <select name="country">
            <option value="id" <%= values.country === 'id' ? 'selected' : '' %>>Indonesia</option>
            <option value="sg" <%= values.country === 'sg' ? 'selected' : '' %>>Singapore</option>
            <option value="us" <%= values.country === 'us' ? 'selected' : '' %>>USA</option>
          </select>
        </label>
        <label>Limit Jumlah VPN (0 = tanpa batas)
          <input type="number" name="limit_vpn" min="0" value="<%= values.limit_vpn %>" required>
        </label>
      </div>
      <div class="form-actions">
        <% if (editing) { %>
          <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
          <a href="/admin/servers" class="btn btn-outline">Batal</a>
        <% } else { %>
          <button type="submit" class="btn btn-primary">Simpan Server</button>
        <% } %>
      </div>
    </form>
  </div>

  <div class="card">
    <h3>List Server</h3>
    <% if (servers.length === 0) { %>
      <p class="muted">Belum ada server. Tambahkan server pertama di atas.</p>
    <% } else { %>
      <% servers.forEach(s => { %>
        <div class="card server-list-card <%= editing && editing.id == s.id ? 'server-list-card-edit server-list-card-open' : '' %>">
          <button type="button" class="server-card-toggle" onclick="toggleServerCard(this)">
            <div class="server-card-title">
              <strong class="server-card-label"><%= s.label %></strong>
              <span class="badge badge-country"><%= s.code %></span>
            </div>
            <svg class="chevron server-card-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="server-card-actions">
            <a href="/admin/servers?edit=<%= s.id %>" class="btn btn-outline btn-sm">Edit</a>
            <a href="/admin/servers/<%= s.id %>/packages" class="btn btn-outline btn-sm">Pricing</a>
            <form method="post" action="/admin/servers/<%= s.id %>/delete" class="inline-form"
                  onsubmit="return confirm('Hapus server <%= s.code %> — <%= s.label %> beserta semua package-nya?');">
              <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
            </form>
          </div>
          <div class="server-card-body">
            <div class="server-card-info">
              <span class="server-card-info-label">Endpoint</span>
              <span class="server-card-info-value"><%= s.endpoint %></span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">API Key</span>
              <span class="server-card-info-value"><%= s.api_key.slice(0, 6) %>...</span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">Limit VPN</span>
              <span class="server-card-info-value"><%= s.limit_vpn === 0 ? 'Tak terbatas' : s.limit_vpn %></span>
            </div>
            <div class="server-card-info">
              <span class="server-card-info-label">Country</span>
              <span class="server-card-info-value"><%= ({id:'Indonesia', sg:'Singapore', us:'USA'})[s.country] || s.country %></span>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
  <script>
    function toggleServerCard(btn) {
      btn.closest('.server-list-card').classList.toggle('server-list-card-open');
    }
  </script>
<%- include('../partials/footer') %>