<%- include('../partials/head') %>
  <div class="page-title">
    <h1>User Manager</h1>
    <p>Kelola saldo &amp; akun VPN setiap user.</p>
  </div>

  <div class="card">
    <h3>Daftar User</h3>
    <% if (users.length === 0) { %>
      <p class="muted">Belum ada user terdaftar.</p>
    <% } else { %>
      <div class="table-wrap"><table class="table">
        <thead>
          <tr>
            <th>ID</th><th>Username</th><th>Saldo</th><th>Jumlah Akun</th><th>Terdaftar</th><th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.id %></td>
              <td><strong><%= u.username %></strong></td>
              <td><%= formatRupiah(u.saldo) %></td>
              <td><%= u.account_count %></td>
              <td><%= new Date(u.created_at + 'Z').toLocaleDateString('id-ID') %></td>
              <td><a href="/admin/users/<%= u.id %>" class="btn btn-outline btn-sm">Kelola</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
<%- include('../partials/footer') %>