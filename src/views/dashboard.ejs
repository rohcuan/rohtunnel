<%- include('partials/head') %>
  <div class="header-section">
    <div>
      <div class="page-title">Dashboard User</div>
      <div class="page-subtitle">Selamat datang kembali, <%= user.username %>!</div>
    </div>
  </div>

  <div class="banner">
    <div class="banner-grid">
      <div class="banner-item">
        <div class="label">Saldo</div>
        <div class="value"><%= formatRupiah(user.saldo) %></div>
      </div>
      <div class="banner-item">
        <div class="label">Akun VPN Aktif</div>
        <div class="value"><%= stats.active %></div>
      </div>
      <div class="banner-item">
        <div class="label">Total Akun</div>
        <div class="value"><%= stats.total %></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="header-section">
      <h2>Menu</h2>
    </div>
    <div class="menu-grid">
      <a href="/beli" class="btn btn-outline">Beli VPN</a>
      <a href="/akun" class="btn btn-outline">Akun VPN Saya</a>
      <a href="/topup" class="btn btn-outline">Topup Saldo</a>
      <a href="<%= contactAdmin %>" target="_blank" rel="noopener" class="btn btn-outline">Hubungi Admin</a>
    </div>
  </div>
<%- include('partials/footer') %>