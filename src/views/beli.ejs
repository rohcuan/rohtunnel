<%- include('partials/head') %>
  <div class="page-title">
    <h1>Beli VPN</h1>
    <p>Saldo Anda: <strong><%= formatRupiah(user.saldo) %></strong></p>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <% if (servers.length === 0) { %>
    <div class="alert alert-error">Belum ada server tersedia. Hubungi admin.</div>
  <% } else { %>
  <div class="card">
    <form method="post" action="/beli">
      <div class="server-picker">
        <div class="filter-chips">
          <button type="button" class="chip chip-active" data-country="">Semua</button>
          <button type="button" class="chip" data-country="id"><img src="/flags/id.svg" alt="Indonesia" class="chip-flag"> Indonesia</button>
          <button type="button" class="chip" data-country="sg"><img src="/flags/sg.svg" alt="Singapore" class="chip-flag"> Singapore</button>
          <button type="button" class="chip" data-country="us"><img src="/flags/us.svg" alt="USA" class="chip-flag"> USA</button>
        </div>
        <p class="muted server-picker-hint">Ketuk salah satu server di bawah untuk melanjutkan.</p>
        <div class="server-grid">
          <% servers.forEach(s => { %>
            <label class="server-card" data-country="<%= s.country %>">
              <input type="radio" name="server_id" value="<%= s.id %>" <%= selectedId == s.id ? 'checked' : '' %> required>
              <div class="server-flag">
                <img src="/flags/<%= s.country %>.svg" alt="<%= s.country.toUpperCase() %>">
              </div>
              <div class="server-info">
                <div class="server-name">
                  <span class="badge badge-country"><%= s.code %></span>
                  <span class="server-country"><%= s.country.toUpperCase() %></span>
                </div>
                <div class="server-label"><%= s.label %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>
      <div id="checkout-section" class="checkout-section hidden">
        <div class="row">
          <label>Protocol
            <select name="protocol" id="protocol-select" required>
              <option value="ssh">SSH Tunnel</option>
              <option value="vmess">VMess</option>
              <option value="vless">VLess</option>
              <option value="trojan">Trojan</option>
            </select>
          </label>
          <label>Package
            <select name="package_id" id="package-select" required></select>
          </label>
        </div>
        <div class="row">
          <label>Username VPN (opsional, kosong = random)
            <input type="text" name="username" minlength="3" maxlength="20"
                   placeholder="Kosongkan untuk random" pattern="[a-zA-Z0-9_-]{3,20}">
          </label>
          <label id="uuid-row">UUID Custom (opsional, kosong = random)
            <input type="text" name="uuid" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx">
          </label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Checkout</button>
        </div>
        <p class="muted">Saldo akan dipotong otomatis setelah akun berhasil dibuat di server.</p>
      </div>
    </form>
  </div>
  <% } %>

  <script>
    const PACKAGES = <%- JSON.stringify(packages).replace(/</g, '\\u003c') %>;
    const protocolSel = document.getElementById('protocol-select');
    const packageSel = document.getElementById('package-select');
    const uuidRow = document.getElementById('uuid-row');
    const checkoutSection = document.getElementById('checkout-section');
    const serverRadios = Array.from(document.querySelectorAll('input[name="server_id"]'));

    const getServerId = () => {
      const checked = serverRadios.find(r => r.checked);
      return checked ? checked.value : '';
    };
    const markSelected = () => {
      document.querySelectorAll('.server-card').forEach(card =>
        card.classList.toggle('selected', card.querySelector('input').checked));
    };
    const revealCheckout = () => checkoutSection.classList.remove('hidden');

    function refreshPackages() {
      const list = PACKAGES.filter(p =>
        p.server_id == getServerId() && p.protocol === protocolSel.value);
      packageSel.innerHTML = '';
      if (list.length === 0) {
        const o = document.createElement('option');
        o.value = '';
        o.textContent = 'Belum ada package';
        packageSel.appendChild(o);
      }
      list.forEach(p => {
        const o = document.createElement('option');
        o.value = p.id;
        o.textContent = p.name + ' — Rp' + p.price.toLocaleString('id-ID') +
          ' (' + p.kuota_gb + ' GB, ' + p.limit_ip + ' IP, ' + p.days + ' hari)';
        packageSel.appendChild(o);
      });
    }

    function refreshUuidVisibility() {
      uuidRow.style.display = protocolSel.value === 'ssh' ? 'none' : 'flex';
    }

    serverRadios.forEach(r => r.addEventListener('change', () => {
      markSelected();
      revealCheckout();
      refreshPackages();
    }));

    protocolSel.addEventListener('change', () => { refreshPackages(); refreshUuidVisibility(); });

    document.querySelectorAll('.filter-chips .chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.filter-chips .chip').forEach(c => c.classList.remove('chip-active'));
        chip.classList.add('chip-active');
        const country = chip.dataset.country;
        document.querySelectorAll('.server-card').forEach(card => {
          card.classList.toggle('hidden', !!country && card.dataset.country !== country);
        });
        const checked = serverRadios.find(r => r.checked);
        if (!checked || checked.closest('.server-card').classList.contains('hidden')) {
          const firstVisible = document.querySelector('.server-card:not(.hidden) input');
          if (firstVisible) { firstVisible.checked = true; markSelected(); revealCheckout(); }
        }
        refreshPackages();
      });
    });

    if (serverRadios.some(r => r.checked)) {
      markSelected();
      revealCheckout();
    }
    refreshPackages();
    refreshUuidVisibility();
  </script>
<%- include('partials/footer') %>