<%- include('partials/head') %>
  <div class="page-title">
    <h1>Topup Saldo Panel</h1>
    <p>Isi saldo secara otomatis lewat QRIS. Saldo masuk begitu pembayaran terkonfirmasi.</p>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <% if (!qrisReady) { %>
  <div class="card">
    <div class="alert">Topup QRIS sedang tidak tersedia. Silakan hubungi admin untuk topup manual.</div>
  </div>
  <% } else { %>
  <div class="card" style="max-width:520px;">
    <div class="saldo-box" style="margin-bottom:18px;">
      <h3>Saldo Panel Saat Ini</h3>
      <div style="font-size:1.5rem;font-weight:700;color:#059669;"><%= formatRupiah(user.saldo) %></div>
    </div>

    <label style="font-size:.82rem;font-weight:600;color:#374151;display:block;margin-bottom:8px;">Pilih nominal topup</label>
    <div class="amount-grid">
      <button type="button" class="amount-btn" data-value="10000" onclick="selectAmountBtn(10000)">10.000</button>
      <button type="button" class="amount-btn" data-value="20000" onclick="selectAmountBtn(20000)">20.000</button>
      <button type="button" class="amount-btn" data-value="50000" onclick="selectAmountBtn(50000)">50.000</button>
      <button type="button" class="amount-btn" data-value="100000" onclick="selectAmountBtn(100000)">100.000</button>
      <button type="button" class="amount-btn" data-value="200000" onclick="selectAmountBtn(200000)">200.000</button>
      <button type="button" class="amount-btn" data-value="500000" onclick="selectAmountBtn(500000)">500.000</button>
    </div>

    <label for="topup-amount" style="font-size:.82rem;font-weight:600;color:#374151;">Atau ketik nominal sendiri</label>
    <input type="number" id="topup-amount" min="<%= min %>" max="<%= max %>" step="1000"
           placeholder="Contoh: 25000" oninput="updateSummary()" style="margin-top:6px;">
    <div style="font-size:.72rem;color:#9ca3af;margin-top:4px;">Min <%= min.toLocaleString('id-ID') %> &middot; Maks <%= max.toLocaleString('id-ID') %></div>

    <div class="saldo-box" style="margin-top:14px;">
      <h3>Ringkasan</h3>
      <div class="saldo-row">
        <span class="k">Nominal topup</span>
        <span class="v" id="sum-nominal">0 IDR</span>
      </div>
      <div class="saldo-row">
        <span class="k">Kode unik / biaya admin</span>
        <span class="v">acak 1&ndash;250 IDR</span>
      </div>
      <div class="saldo-row total">
        <span class="k">Total yang dibayarkan</span>
        <span class="v" id="sum-total">0 IDR</span>
      </div>
    </div>

    <div id="form-msg" style="display:none;margin-top:12px;padding:10px 12px;border-radius:8px;background:#fef2f2;color:#991b1b;font-size:.82rem;"></div>

    <div class="topup-note">
      <strong>Saldo Panel</strong> digunakan untuk membeli dan memperpanjang akun VPN. Jika baru pertama kali, coba topup kecil dulu untuk mencoba alurnya.
    </div>

    <div style="margin-top:16px;">
      <button class="btn btn-success" id="create-btn" onclick="createTopup()">Buat Kode QRIS</button>
    </div>
  </div>
  <% } %>

  <div class="qr-overlay" id="qr-overlay" onclick="if(event.target===this)closeQr(false)">
    <div class="qr-window">
      <button class="qr-close" onclick="closeQr(false)">&times;</button>

      <div id="qr-view-loading">
        <h3>Menyiapkan QRIS</h3>
        <p>Mengambil kode QR dari payment gateway...</p>
        <div class="spinner"></div>
        <div class="load-error" id="qr-load-error"></div>
        <div style="margin-top:14px;display:none;" id="qr-load-retry-wrap">
          <button class="btn btn-success" id="qr-load-retry" style="width:100%;" onclick="fetchQr()">Coba lagi</button>
        </div>
      </div>

      <div id="qr-view-pay">
        <h3>Scan QRIS</h3>
        <p>Selesaikan pembayaran dengan memindai kode QR ini.</p>
        <img class="qr-img" id="qr-img" alt="QRIS" src="">
        <div class="qr-total">
          Nominal: <span id="qr-nominal">&mdash;</span> &middot; Kode unik: <span id="qr-fee">&mdash;</span><br>
          Total: <strong id="qr-total">&mdash;</strong>
        </div>
        <div style="margin-top:10px;font-size:.85rem;color:#374151;">
          Sisa waktu: <strong id="qr-timer" style="font-family:ui-monospace,monospace;">&mdash;</strong>
        </div>
        <div id="qr-expired-note" style="display:none;margin-top:8px;padding:10px 12px;border-radius:8px;background:#fef2f2;color:#991b1b;font-size:.8rem;line-height:1.5;">
          QRIS sudah kedaluwarsa dan tidak dapat dipindai lagi. Jika sudah membayar, tekan <strong>Cek Pembayaran</strong>.
        </div>
        <div style="margin-top:14px;">
          <button class="btn btn-success" id="check-btn" onclick="checkStatus()" style="width:100%;">Cek Pembayaran</button>
        </div>
        <div class="qr-hint">QRIS berlaku 5 menit. Atau tekan <strong>Cek Pembayaran</strong> agar tidak perlu menunggu terlalu lama.</div>
      </div>

      <div id="qr-view-success" style="display:none;">
        <h3 class="success-title">Topup Berhasil!</h3>
        <p>Pembayaran terkonfirmasi dan saldo sudah ditambahkan ke akunmu.</p>
        <div class="success-box">
          <div class="success-row">
            <span class="k">Saldo ditambahkan</span>
            <span class="v added" id="success-added">&mdash;</span>
          </div>
          <div class="success-row total">
            <span class="k">Saldo panel sekarang</span>
            <span class="v" id="success-balance">&mdash;</span>
          </div>
        </div>
        <div style="margin-top:16px;">
          <button class="btn btn-success" onclick="closeQr(true)" style="width:100%;">Selesai</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="qrisClosedModal" onclick="if(event.target===this)closeQrisClosedModal()">
    <div class="modal">
      <h3>Tidak sengaja menutup QRIS?</h3>
      <div class="modal-body">
        <p style="margin:0;">Topup kamu yang masih aktif bisa dilihat kembali. Buka <strong>Riwayat Saldo Panel</strong> dan pilih <strong>Lihat kode QRIS</strong> untuk membukanya lagi.</p>
      </div>
      <div class="modal-actions">
        <a href="/topup/riwayat" class="btn btn-primary">Buka Riwayat Saldo Panel</a>
        <button type="button" class="btn btn-outline" onclick="closeQrisClosedModal()">Tutup</button>
      </div>
    </div>
  </div>

  <script>
    var COOLDOWN = 10;
    var currentTopupId = null;
    var qrExpires = 0;
    var qrTimerInt = null;
    var currentQrParams = null;

    function fmtIdr(n) { return Number(n || 0).toLocaleString('id-ID'); }

    function selectAmountBtn(val) {
      var input = document.getElementById('topup-amount');
      input.value = val;
      document.querySelectorAll('.amount-btn').forEach(function(b) {
        b.classList.toggle('active', Number(b.dataset.value) === val);
      });
      updateSummary();
    }

    function updateSummary() {
      var raw = document.getElementById('topup-amount').value.trim();
      var amount = parseInt(raw, 10);
      if (!raw || isNaN(amount) || amount <= 0) amount = 0;
      document.getElementById('sum-nominal').textContent = fmtIdr(amount) + ' IDR';
      document.getElementById('sum-total').textContent = amount > 0 ? fmtIdr(amount) + ' IDR' : '0 IDR';
    }

    function createTopup() {
      var btn = document.getElementById('create-btn');
      var msgEl = document.getElementById('form-msg');
      if (btn.disabled) return;
      var amount = parseInt(document.getElementById('topup-amount').value.trim(), 10);
      if (!amount || amount < <%= min %> || amount > <%= max %>) {
        msgEl.textContent = 'Nominal harus antara <%= min.toLocaleString("id-ID") %> dan <%= max.toLocaleString("id-ID") %> IDR.';
        msgEl.style.display = 'block';
        return;
      }
      msgEl.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Membuat QRIS...';

      var fd = new FormData();
      fd.append('amount', amount);
      fetch('/topup/create', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          btn.disabled = false;
          btn.textContent = 'Buat Kode QRIS';
          if (!res.ok) {
            msgEl.textContent = res.message || 'Gagal membuat QRIS.';
            msgEl.style.display = 'block';
            return;
          }
          loadQr(res.id, res.amount, res.fee, res.total);
        })
        .catch(function(e) {
          btn.disabled = false;
          btn.textContent = 'Buat Kode QRIS';
          msgEl.textContent = 'Terjadi kesalahan: ' + e.message;
          msgEl.style.display = 'block';
        });
    }

    function loadQr(topupId, amount, fee, total) {
      currentTopupId = topupId;
      currentQrParams = { id: topupId, amount: amount, fee: fee, total: total };
      showQrLoading(amount, fee, total);
      fetchQr();
    }

    function fetchQr() {
      var p = currentQrParams;
      if (!p) return;
      document.getElementById('qr-load-error').classList.remove('show');
      document.getElementById('qr-load-retry-wrap').style.display = 'none';
      fetch('/topup/qr/' + p.id, { credentials: 'same-origin', cache: 'no-store' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (currentQrParams !== p) return;
          if (!res.ok) {
            showQrError(res.message || 'Payment gateway sedang offline. QRIS tidak dapat ditampilkan.');
            return;
          }
          showQr(res.qr_img, res.expires_ts);
        })
        .catch(function() {
          if (currentQrParams !== p) return;
          showQrError('Payment gateway sedang offline. QRIS tidak dapat ditampilkan.');
        });
    }

    function showQrLoading(amount, fee, total) {
      qrExpires = 0;
      document.getElementById('qr-nominal').textContent = fmtIdr(amount) + ' IDR';
      document.getElementById('qr-fee').textContent = fmtIdr(fee) + ' IDR';
      document.getElementById('qr-total').textContent = fmtIdr(total) + ' IDR';
      setQrViewState('loading');
      document.getElementById('qr-overlay').classList.add('show');
    }

    function showQrError(msg) {
      setQrViewState('loading');
      var errEl = document.getElementById('qr-load-error');
      errEl.textContent = msg;
      errEl.classList.add('show');
      document.getElementById('qr-load-retry-wrap').style.display = '';
    }

    function showQr(src, expires) {
      qrExpires = parseInt(expires, 10) || 0;
      var img = document.getElementById('qr-img');
      if (img) { img.src = src || ''; img.style.display = ''; }
      var note = document.getElementById('qr-expired-note');
      if (note) note.style.display = 'none';
      setQrViewState('pay');
      resetCheckBtn();
      document.getElementById('qr-overlay').classList.add('show');
      tickQrTimer();
      if (qrTimerInt) clearInterval(qrTimerInt);
      qrTimerInt = setInterval(tickQrTimer, 1000);
    }

    function setQrViewState(state) {
      document.getElementById('qr-view-loading').style.display = state === 'loading' ? '' : 'none';
      document.getElementById('qr-view-pay').style.display = state === 'pay' ? '' : 'none';
      document.getElementById('qr-view-success').style.display = state === 'success' ? '' : 'none';
    }

    function tickQrTimer() {
      var el = document.getElementById('qr-timer');
      if (!el) return;
      if (!qrExpires) { el.textContent = '\u2014'; return; }
      var left = qrExpires - Math.floor(Date.now() / 1000);
      if (left <= 0) {
        el.textContent = 'Expired';
        var img = document.getElementById('qr-img');
        if (img) img.style.display = 'none';
        var note = document.getElementById('qr-expired-note');
        if (note) note.style.display = '';
        if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
        return;
      }
      var m = Math.floor(left / 60), s = left % 60;
      el.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
    }

    function resetCheckBtn() {
      var btn = document.getElementById('check-btn');
      if (!btn) return;
      btn.disabled = false;
      btn.textContent = 'Cek Pembayaran';
      if (window.checkCdInt) { clearInterval(window.checkCdInt); window.checkCdInt = null; }
    }

    function armCheckCooldown(seconds) {
      var btn = document.getElementById('check-btn');
      if (!btn) return;
      if (window.checkCdInt) { clearInterval(window.checkCdInt); window.checkCdInt = null; }
      var deadline = Date.now() + seconds * 1000;
      btn.disabled = true;
      btn.textContent = 'Tunggu ' + fmtLeft(seconds);
      window.checkCdInt = setInterval(function() {
        var left = Math.max(0, Math.round((deadline - Date.now()) / 1000));
        if (left <= 0) {
          clearInterval(window.checkCdInt);
          window.checkCdInt = null;
          btn.disabled = false;
          btn.textContent = 'Cek Pembayaran';
          return;
        }
        btn.textContent = 'Tunggu ' + fmtLeft(left);
      }, 1000);
    }

    function fmtLeft(s) {
      var m = Math.floor(s / 60), r = s % 60;
      return m > 0 ? m + 'm ' + (r < 10 ? '0' : '') + r + 's' : r + 's';
    }

    function checkStatus() {
      var btn = document.getElementById('check-btn');
      var tid = currentTopupId;
      if (!tid) return;
      if (btn && btn.disabled) return;
      if (btn) { btn.disabled = true; btn.textContent = 'Mengecek...'; }
      var fd = new FormData();
      fd.append('topup_id', tid);
      fetch('/topup/check', { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(res) {
          if (currentTopupId !== tid) return;
          var cd = parseInt(res.cooldown || '0', 10);
          if (!res.ok) {
            if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
            alert(res.message || 'Gagal mengecek status.');
            return;
          }
          if (res.status === 'paid') {
            if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
            document.getElementById('success-added').textContent = '+' + fmtIdr(res.credited) + ' IDR';
            document.getElementById('success-balance').textContent = fmtIdr(res.new_balance) + ' IDR';
            setQrViewState('success');
            return;
          }
          if (res.status === 'expired') {
            if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
            var timerEl = document.getElementById('qr-timer');
            if (timerEl) timerEl.textContent = 'Expired';
            var img = document.getElementById('qr-img');
            if (img) img.style.display = 'none';
            var note = document.getElementById('qr-expired-note');
            if (note) note.style.display = '';
            if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
            alert(res.message || 'QRIS kedaluwarsa dan tidak ada pembayaran masuk.');
            return;
          }
          if (btn) armCheckCooldown(cd > 0 ? cd : COOLDOWN);
          alert(res.message || 'Belum ada pembayaran terdeteksi.');
        })
        .catch(function() { if (btn) resetCheckBtn(); });
    }

    function closeQr(reload) {
      var ov = document.getElementById('qr-overlay');
      var wasPaid = document.getElementById('qr-view-success').style.display !== 'none';
      ov.classList.remove('show');
      if (qrTimerInt) { clearInterval(qrTimerInt); qrTimerInt = null; }
      resetCheckBtn();
      document.getElementById('qr-load-error').classList.remove('show');
      document.getElementById('qr-load-retry-wrap').style.display = 'none';
      currentQrParams = null;
      currentTopupId = null;
      if (reload && wasPaid) { location.reload(); return; }
      if (!wasPaid) {
        document.getElementById('qrisClosedModal').classList.add('show');
      }
    }
    function closeQrisClosedModal() {
      document.getElementById('qrisClosedModal').classList.remove('show');
    }
  </script>
<%- include('partials/footer') %>